<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            SetSize="480 420"
            MinSize="420 320"
                      Title="{Loc 'cargo-pallet-console-menu-title'}">
    <BoxContainer Orientation="Vertical" Margin="5">
        <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'cargo-pallet-menu-appraisal-label'}"
                     StyleClasses="LabelKeyText" />
              <Control HorizontalExpand="True" />
              <Label Name="AppraisalLabel"
                     Text="{Loc 'cargo-pallet-menu-no-goods-text'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'cargo-pallet-menu-count-label'}"
                     StyleClasses="LabelKeyText" />
              <Control HorizontalExpand="True" />
              <Label Name="CountLabel"
                     Text="{Loc 'cargo-pallet-menu-no-goods-text'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'cargo-pallet-menu-crate-multiplier-label'}"
                   StyleClasses="LabelKeyText" />
              <Control HorizontalExpand="True" />
              <Label Name="TradeCrateMultiplierLabel"
                   Text="1.00x" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'cargo-pallet-menu-other-multiplier-label'}"
                   StyleClasses="LabelKeyText" />
              <Control HorizontalExpand="True" />
              <Label Name="OtherMultiplierLabel"
                   Text="1.00x" />
        </BoxContainer>
        <!-- Exodus-begin: scrollable per-item appraisal -->
        <Label Text="{Loc 'cargo-pallet-menu-items-label'}"
               StyleClasses="LabelKeyText"
               Margin="0 6 0 2" />
        <ScrollContainer HorizontalExpand="True"
                         VerticalExpand="True"
                         MinHeight="160"
                         HScrollEnabled="False">
            <BoxContainer Name="ItemsList"
                          Orientation="Vertical"
                          HorizontalExpand="True" />
        </ScrollContainer>
        <!-- Exodus-end -->
        <Control MinSize="0 5" HorizontalExpand="True"/>
        <Button Name="AppraiseButton"
                Text="{Loc 'cargo-pallet-appraise-button'}"/>
        <Button Name="SellButton"
                Text="{Loc 'cargo-pallet-sell-button'}"/>
    </BoxContainer>
</controls:FancyWindow>
